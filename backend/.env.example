LETSGOSA_ENV=development
LETSGOSA_DATABASE_URL=sqlite:///./letsgosa.db
GOOGLE_CLOUD_PROJECT=letsgodb
FIREBASE_PROJECT_ID=letsgodb
FIREBASE_ADMIN_ROLE=admin
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
CONTENT_DATA_DIR=data
CONVERSATION_STORAGE_DIR=data/conversations
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://letsgodb.web.app,https://letsgodb.firebaseapp.com
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=package-images
MINIO_SECURE=false
# Legacy alias still supported:
LETSGOSA_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://letsgodb.web.app,https://letsgodb.firebaseapp.com
