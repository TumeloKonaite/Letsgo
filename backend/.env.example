# Backend web + jobs | Required | Exact tier: development, test, staging, production.
LETSGOSA_ENV=development
# Backend web + jobs | Required | PostgreSQL in staging/production; explicit SQLite is allowed locally.
LETSGOSA_DATABASE_URL=sqlite:///./letsgosa.db
# Backend web | Required | Comma-separated exact frontend origins; no wildcard in staging/production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend web | Required, secret | Matching Clerk backend key. Never expose through VITE_*.
CLERK_SECRET_KEY=sk_test_replace-with-development-key
# Backend web | Required | Clerk PEM public JWT key; escaped newlines are supported in local .env files.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nreplace-with-development-public-key\n-----END PUBLIC KEY-----"
# Backend web | Required | Absolute HTTPS issuer for the matching Clerk instance.
CLERK_ISSUER_URL=https://clerk.example.invalid
# Backend web | Required | Comma-separated exact token azp origins; wildcards are rejected; HTTPS in staging/production.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Backend web | Required | Boolean session-claim name used for server-side admin authorization.
CLERK_ADMIN_CLAIM=admin
# Backend webhook | Optional/conditional, secret | Set only after a verified webhook route is implemented.
CLERK_WEBHOOK_SIGNING_SECRET=

# Backend web + storage jobs | Required | Currently supported provider is gcs.
STORAGE_PROVIDER=gcs
# Backend web + storage jobs | Required | Project owning this environment's buckets.
GCP_PROJECT_ID=replace-with-development-project-id
# Backend web + image jobs | Required | Retained private package-image bucket.
GCS_BUCKET_NAME=replace-with-development-image-bucket
# Legacy setting, no longer consumed.
# Deprecated; unused by private storage: GCS_PUBLIC_BASE_URL=https://storage.example.invalid/images
# Planned conversation jobs | Required before deployed chat persistence | Private conversation bucket.
GCS_CONVERSATION_BUCKET_NAME=replace-with-development-conversation-bucket
# Backend web + storage jobs | Required credential method, secret | JSON alternative to a credential file.
GCP_SERVICE_ACCOUNT_JSON=
# Backend web + storage jobs | Required credential method | Local path; use this or GCP_SERVICE_ACCOUNT_JSON.
GOOGLE_APPLICATION_CREDENTIALS=
# Backend web | Optional | Positive maximum image upload size in bytes.
PACKAGE_IMAGE_MAX_UPLOAD_BYTES=5242880

# Backend web | Required for chat in staging/production, secret | Matching OpenAI project key.
OPENAI_API_KEY=replace-with-development-openai-key
# Backend web | Optional | Approved chat model.
OPENAI_MODEL=gpt-4o-mini
# Backend web | Optional | Positive request timeout in seconds.
OPENAI_TIMEOUT_SECONDS=30
# Backend web | Optional | Non-negative retry count.
OPENAI_MAX_RETRIES=2

# Backend web | Required for contact email in staging/production | SMTP relay hostname.
SMTP_HOST=smtp.example.invalid
# Backend web | Required for contact email | Port from 1 through 65535.
SMTP_PORT=587
# Backend web | Optional pair | Relay username; set together with SMTP_PASSWORD.
SMTP_USERNAME=replace-with-development-smtp-user
# Backend web | Optional pair, secret | Relay password; set together with SMTP_USERNAME.
SMTP_PASSWORD=replace-with-development-smtp-password
# Backend web | Required for contact email | Approved sender address.
SMTP_FROM_EMAIL=sender@example.invalid
# Backend web | Required for contact email | Destination mailbox.
CONTACT_TO_EMAIL=contact@example.invalid
# Backend web | Required for contact email | Boolean; keep true unless the relay specifies otherwise.
SMTP_USE_TLS=true

# Backend web | Required in deployed images | Read-only chatbot resource directory.
CONTENT_DATA_DIR=data
# Backend web | Development only, optional | Local conversation storage; forbidden for deployed persistence.
CONVERSATION_STORAGE_DIR=data/conversations

# Backend web | Optional | Non-secret application metadata and behavior.
LETSGOSA_APP_NAME=LetsGoSA API
LETSGOSA_DEBUG=false
LETSGOSA_API_PREFIX=/api
LETSGOSA_API_VERSION=0.1.0

# Private GCS storage. Prefix is prepended to packages/<slug>/<unique-image>.
GCS_PROJECT_ID=
GCS_OBJECT_PREFIX=staging/
GCS_CREDENTIALS_SECRET_NAME=letsgosa-gcs-staging
# Keyless Modal OIDC -> GCP federation (preferred); mutually exclusive with key/file.
GCS_WIF_AUDIENCE=
GCS_SERVICE_ACCOUNT_EMAIL=
