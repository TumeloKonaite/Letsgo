# Copy to ../.env for local development only. Never commit the copy.
# Replace every replace-with-* value with a newly provisioned development value.
LETSGOSA_ENV=development
LETSGOSA_DATABASE_URL=replace-with-development-postgresql-url
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CLERK_SECRET_KEY=replace-with-development-secret-key
CLERK_JWT_KEY=replace-with-development-public-jwt-key
CLERK_ISSUER_URL=replace-with-development-clerk-issuer-url
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
CLERK_ADMIN_CLAIM=admin

STORAGE_PROVIDER=gcs
GCP_PROJECT_ID=replace-with-development-project-id
GCS_BUCKET_NAME=replace-with-development-public-image-bucket
GCS_PUBLIC_BASE_URL=replace-with-development-public-image-base-url
GCS_CONVERSATION_BUCKET_NAME=replace-with-development-private-conversation-bucket
# Modal uses the JSON placeholder; local development should prefer the file path.
GCP_SERVICE_ACCOUNT_JSON=replace-with-new-development-service-account-json
GOOGLE_APPLICATION_CREDENTIALS=replace-with-local-credential-file-path
PACKAGE_IMAGE_MAX_UPLOAD_BYTES=5242880

OPENAI_API_KEY=replace-with-development-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2

SMTP_HOST=replace-with-development-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-development-smtp-username
SMTP_PASSWORD=replace-with-development-smtp-password
SMTP_FROM_EMAIL=replace-with-development-sender-address
CONTACT_TO_EMAIL=replace-with-development-recipient-address
SMTP_USE_TLS=true

CONTENT_DATA_DIR=data
CONVERSATION_STORAGE_DIR=data/conversations
