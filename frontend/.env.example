# Frontend build/browser | Required outside development | Absolute API origin, HTTPS outside development.
# Development alone may omit this and use http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000
# Frontend build/browser | Required, public | Publishable key for the matching Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace-with-development-key
# Frontend build/browser | Required, public | Application-relative Clerk sign-in route.
VITE_CLERK_SIGN_IN_URL=/admin/login
# Frontend build/browser | Required, public | Safe fallback after sign-in.
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin/dashboard
# Frontend build/browser | Required, public | Safe fallback after sign-out.
VITE_CLERK_SIGN_OUT_FALLBACK_REDIRECT_URL=/admin/login
# Frontend build/browser | Required, public | UI hint only; backend authorization is authoritative.
VITE_CLERK_ADMIN_CLAIM=admin

# No other VITE_* names are approved. Never prefix Clerk secret keys, database URLs,
# storage credentials, SMTP/OpenAI credentials, or webhook secrets with VITE_.
