# Copy to .env.local for local development only. Never commit the copy.
# Every VITE_* value is embedded in browser JavaScript and must be public-safe.
VITE_API_BASE_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=replace-with-development-publishable-key
VITE_CLERK_SIGN_IN_URL=/admin/login
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin/dashboard
VITE_CLERK_SIGN_OUT_FALLBACK_REDIRECT_URL=/admin/login
VITE_CLERK_ADMIN_CLAIM=admin
