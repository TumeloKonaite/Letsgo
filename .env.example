LETSGOSA_ENV=development
# Local default:
LETSGOSA_DATABASE_URL=sqlite:///./letsgosa.db
# Cloud Run + Cloud SQL:
# LETSGOSA_DATABASE_URL=postgresql+psycopg://letsgodev:PASSWORD@/letsgo?host=/cloudsql/letsgodb:us-central1:free-trial-first-project
GOOGLE_CLOUD_PROJECT=letsgodb
CLOUD_SQL_CONNECTION_NAME=letsgodb:us-central1:free-trial-first-project
FIREBASE_PROJECT_ID=letsgodb
FIREBASE_ADMIN_ROLE=admin
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=package-images
MINIO_SECURE=false
LETSGOSA_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=letsgodb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=letsgodb
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=letsgodb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_ADMIN_CLAIM=admin
