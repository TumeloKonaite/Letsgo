LETSGOSA_ENV=development
# Local default:
LETSGOSA_DATABASE_URL=sqlite:///./letsgosa.db
# Alias supported by the contact pipeline and common deployment platforms:
# DATABASE_URL=sqlite:///./letsgosa.db
# Cloud Run + Cloud SQL:
# LETSGOSA_DATABASE_URL=postgresql+psycopg://letsgodev:PASSWORD@/letsgo?host=/cloudsql/letsgodb:us-central1:free-trial-first-project
GCP_PROJECT_ID=
CLOUD_SQL_CONNECTION_NAME=letsgodb:us-central1:free-trial-first-project
FIREBASE_PROJECT_ID=letsgodb
FIREBASE_ADMIN_ROLE=admin
GCS_BUCKET_NAME=
GCS_PUBLIC_BASE_URL=
LETSGOSA_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://letsgodb.web.app,https://letsgodb.firebaseapp.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
CONTACT_TO_EMAIL=
SMTP_USE_TLS=true

VITE_API_BASE_URL=https://your-cloud-run-url
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=letsgodb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=letsgodb
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=letsgodb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_ADMIN_CLAIM=admin
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
CONTENT_DATA_DIR=./data
CONVERSATION_STORAGE_DIR=./data/conversations
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://letsgodb.web.app,https://letsgodb.firebaseapp.com
